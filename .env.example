APP_NAME=Inventory & Warehouse Management API
APP_ENV=development
DEBUG=true

# Currently project uses shared Render DB from local .env as well.
# For a private playground later, point this at localhost instead.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/inventory_db

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=180
